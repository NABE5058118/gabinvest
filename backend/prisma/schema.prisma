generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Object {
  id              String    @id @default(cuid())
  title           String
  type            String
  price           Int
  yieldPercent    Float
  location        String
  city            String?
  area            Int
  roi             Float?
  image           String?
  description     String?
  offerFileUrl    String?
  offerFileName   String?
  offerFileType   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  commercialOffer CommercialOffer?
  leads           Lead[]
  favorites       Favorite[]
}

model CommercialOffer {
  id        String   @id @default(cuid())
  objectId  String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  objectId  String
  name      String
  phone     String
  comment   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  consents  Consent[]
}

model User {
  id           String     @id @default(cuid())
  telegramId   String     @unique
  firstName    String?
  lastName     String?
  username     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  favorites    Favorite[]
  consents     Consent[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  objectId  String
  createdAt DateTime @default(now())
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, objectId])
}

model Consent {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  consentType String   // "pd_processing" | "cross_border" | "marketing"
  version     String   // версия текста, например "1.0"
  ipAddress   String?
  userAgent   String?
  telegramId  String?
  acceptedAt  DateTime @default(now())

  @@index([userId])
  @@index([leadId])
}
