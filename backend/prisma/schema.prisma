generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-3.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlacementType {
  standard
  paid
  exclusive
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum PriceIndicator {
  below_market
  market
  above_market
}

enum DealStage {
  offer
  counter_offer
  deposit
  verification
  contract
  registration
  closed
  cancelled
}

enum DealStatus {
  active
  completed
  cancelled
  disputed
}

enum CommissionStatus {
  pending
  reserved
  released
  refunded
}

enum AuditEventType {
  user_registered
  user_verified
  deal_created
  deal_stage_changed
  offer_sent
  counter_offer_sent
  deposit_paid
  contract_signed
  registration_completed
  deal_closed
  payment_received
  commission_reserved
  commission_released
  contact_disclosed
  chat_message_sent
  anti_bypass_violation
  deal_alert_created
}

enum TouchSource {
  direct
  deep_link
  referral
  utm
  qr
  invite
}

enum VerificationMethod {
  telegram
  sms
  email
}

model Object {
  id              String    @id @default(cuid())
  title           String
  type            String
  price           Int
  yieldPercent    Float
  location        String
  city            String?
  area            Int
  image           String?
  description     String?
  monthlyRent     Int?
  annualRevenue   Int?
  leaseEndDate    DateTime?
  anchorTenantName String?
  priceIndicator  PriceIndicator?
  @@index([city])
  @@index([type])
  @@index([price])
  @@index([area])
  @@index([yieldPercent])
  @@index([leaseEndDate])
  @@index([createdAt])
  images          ObjectImage[]
  offerFileUrl    String?
  offerFileName   String?
  offerFileType   String?
  expenses        Expense[]
  legalConstraints LegalConstraint[]
  engineeringSpec EngineeringSpec?
  vatRate         VatRate?
  moderation      Moderation?
  placement       Placement?
  tenants         Tenant[]
  leases          Lease[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  commercialOffer CommercialOffer?
  leads           Lead[]
  favorites       Favorite[]
  deals           Deal[]
}

model ObjectImage {
  id        String   @id @default(cuid())
  objectId  String
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  isAnchor  Boolean  @default(false)
  category  String?
  objectId  String
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  leases    Lease[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectId])
}

model Lease {
  id              String   @id @default(cuid())
  objectId        String
  tenantId        String
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Int
  isFixed         Boolean  @default(true)
  percentOfTurnover Float?
  indexationPercent Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  object          Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([objectId])
  @@index([tenantId])
  @@index([endDate])
}

model Expense {
  id                String   @id @default(cuid())
  objectId          String
  name              String
  amount            Int
  compensatedByTenant Boolean @default(false)
  ownerOnly         Boolean  @default(false)
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  object            Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId])
}

model LegalConstraint {
  id        String   @id @default(cuid())
  objectId  String
  type      String
  description String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId])
}

model EngineeringSpec {
  id           String   @id @default(cuid())
  objectId     String   @unique
  electricityKw Int?
  waterParams  String?
  gasParams    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  object       Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
}

model VatRate {
  id        String   @id @default(cuid())
  objectId  String   @unique
  rate      Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
}

model Moderation {
  id          String         @id @default(cuid())
  objectId    String         @unique
  status      ModerationStatus @default(pending)
  note        String?
  moderatedAt DateTime?
  moderatedBy String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  object      Object         @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Placement {
  id          String        @id @default(cuid())
  objectId    String        @unique
  type        PlacementType @default(standard)
  price       Int?
  isExclusive Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  object      Object        @relation(fields: [objectId], references: [id], onDelete: Cascade)
}

model CommercialOffer {
  id        String   @id @default(cuid())
  objectId  String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  objectId  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  clientId  String?
  name      String
  phone     String
  comment   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  consents  Consent[]

  @@index([userId])
  @@index([clientId])
  @@index([objectId])
  @@index([status])
  @@index([createdAt])
}

model User {
  id               String     @id @default(cuid())
  telegramId       String?    @unique
  telegramPhotoUrl String?
  telegramLang     String?
  telegramPremium  Boolean?   @default(false)
  telegramAllowsPm Boolean?   @default(false)
  phone            String?
  email            String?
  passwordHash     String?
  role             String?    @default("user")
  @@index([role])
  firstName        String?
  lastName         String?
  username         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  favorites        Favorite[]
  consents         Consent[]
  leads            Lead[]
  dealsAsBuyer     Deal[]  @relation("dealBuyer")
  dealsAsSeller    Deal[]  @relation("dealSeller")
  dealsAsAgent     Deal[]  @relation("dealAgent")
  referralsAsReferrer Referral[] @relation("referralReferrer")
  referralsAsReferee  Referral[] @relation("referralReferee")
  auditEvents      AuditEvent[] @relation("auditUser")
  phoneVerifications PhoneVerification[] @relation("phoneVerificationUser")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  objectId  String
  createdAt DateTime @default(now())
  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, objectId])
}

model Consent {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  consentType String   // "pd_processing" | "cross_border" | "marketing"
  version     String   // версия текста, например "1.0"
  ipAddress   String?
  userAgent   String?
  telegramId  String?
  acceptedAt  DateTime @default(now())

  @@index([userId])
  @@index([leadId])
  @@index([consentType])
  @@index([acceptedAt])
}

model Payment {
  id          String   @id @default(cuid())
  dealId      String?
  objectId    String
  amount      Int
  currency    String @default("RUB")
  method      String?
  status      String @default("pending")
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deal        Deal?    @relation(fields: [dealId], references: [id])

  @@index([objectId])
  @@index([status])
  @@index([dealId])
}

model Attribution {
  id                  String         @id @default(cuid())
  userId              String         @unique
  telegramId          String?        @unique
  phone               String?        @unique
  email               String?
  firstTouchSource    TouchSource    @default(direct)
  firstTouchCampaign  String?
  firstTouchReferrer  String?
  firstSeenAt         DateTime       @default(now())
  lastSeenAt          DateTime       @default(now())
  lastIp              String?
  deviceFingerprint   String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([firstTouchSource])
  @@index([firstSeenAt])
  @@index([phone])
  @@index([telegramId])
}

model Deal {
  id            String       @id @default(cuid())
  objectId      String
  buyerId       String
  sellerId      String?
  agentId       String?
  price         Int
  currency      String        @default("RUB")
  stage         DealStage     @default(offer)
  status        DealStatus    @default(active)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  closedAt      DateTime?
  buyer         User         @relation("dealBuyer", fields: [buyerId], references: [id])
  seller        User?        @relation("dealSeller", fields: [sellerId], references: [id])
  agent         User?        @relation("dealAgent", fields: [agentId], references: [id])
  object        Object       @relation(fields: [objectId], references: [id], onDelete: Cascade)
  stages        DealStageLog[]
  payments      Payment[]
  commissions   Commission[]
  events        AuditEvent[]
  chats         Chat[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([stage])
  @@index([status])
  @@index([objectId])
  @@index([createdAt])
}

model DealStageLog {
  id        String     @id @default(cuid())
  dealId    String
  fromStage String?
  toStage   String
  changedBy String
  note      String?
  createdAt DateTime   @default(now())
  deal      Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([createdAt])
}

model Commission {
  id              String            @id @default(cuid())
  dealId          String
  amount          Int
  rate            Int               @default(20)
  status          CommissionStatus  @default(pending)
  reservedAt      DateTime?
  releasedAt      DateTime?
  releasedTo      String?
  paymentMethod   String?
  providerRef     String?
  bankStatementUrl String?
  confirmedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deal            Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  payouts         Payout[]

  @@index([dealId])
  @@index([status])
  @@index([createdAt])
}

model AuditEvent {
  id            String          @id @default(cuid())
  eventType     AuditEventType
  userId        String?
  dealId        String?
  objectId      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())
  user          User?           @relation("auditUser", fields: [userId], references: [id])
  deal          Deal?           @relation(fields: [dealId], references: [id])

  @@index([eventType])
  @@index([userId])
  @@index([dealId])
  @@index([objectId])
  @@index([createdAt])
}

model Chat {
  id           String         @id @default(cuid())
  dealId       String
  participant1 String
  participant2 String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deal         Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([dealId])
  @@index([participant1])
}

model ChatMessage {
  id          String   @id @default(cuid())
  chatId      String
  senderId    String
  body        String
  filtered    Boolean  @default(false)
  filterReason String?
  createdAt   DateTime @default(now())
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
}

model PhoneVerification {
  id            String            @id @default(cuid())
  userId        String?
  phone         String
  codeHash      String
  method        VerificationMethod
  attempts      Int               @default(0)
  maxAttempts   Int               @default(5)
  verified      Boolean           @default(false)
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())
  user          User?             @relation("phoneVerificationUser", fields: [userId], references: [id])

  @@index([phone])
  @@index([expiresAt])
  @@index([verified])
}

model Referral {
  id            String   @id @default(cuid())
  referrerId   String
  refereeId    String
  source       String
  createdAt    DateTime @default(now())
  referrer     User     @relation("referralReferrer", fields: [referrerId], references: [id])
  referee      User     @relation("referralReferee", fields: [refereeId], references: [id])

  @@unique([referrerId, refereeId])
  @@index([referrerId])
  @@index([refereeId])
}

model AntiBypassRule {
  id          String   @id @default(cuid())
  name        String
  pattern     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentProvider {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payout {
  id            String   @id @default(cuid())
  commissionId  String
  amount        Int
  toUserId      String?
  toAccount     String
  status        String  @default("pending")
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  commission    Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
  @@index([status])
}
